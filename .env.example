# You do not need this file to develop. `npm create @joinbankroll/app` writes
# .env.local at scaffold time — STORE=fs, the app name, and an RPC — and the
# dev signing key lives in ~/.config/bankroll/keypair.json, outside the
# project. This documents what a DEPLOYMENT needs.

# Where state lives. Unset means Vercel Blob, which is what a deployment uses.
# .env.local carries STORE=fs locally so the app runs with no Vercel account;
# it is gitignored, so that never reaches a deployment.
STORE=

# The app's one secret: a base58 Solana secret key for the treasury wallet.
# It receives payments and signs payouts. Generate a key for production that is
# NOT the development one, and store it in Vercel as a SENSITIVE environment
# variable (write-only — unreadable afterwards, by anyone).
# Without it the app still runs; it just can't take or send money.
BANKROLL_TREASURY_KEY=

# Shown when a user connects the app.
BANKROLL_APP_NAME=

# A Solana RPC endpoint. Any provider works; the free tiers are fine to start.
SOLANA_RPC_URL=

# Set automatically when you connect a Vercel Blob store to the project —
# no value to copy by hand.
BLOB_READ_WRITE_TOKEN=
