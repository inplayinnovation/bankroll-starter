# You do not need this file to develop. `npm create @joinbankroll/app` writes
# .env.local at scaffold time — STORE=fs, the app name, and an RPC — and the
# dev signing key lives in ~/.config/bankroll/keypair.json, outside the
# project. This documents what a DEPLOYMENT needs.

# Where state lives. Unset means Vercel Blob, which is what a deployment uses.
# .env.local carries STORE=fs locally so the app runs with no Vercel account;
# it is gitignored, so that never reaches a deployment.
STORE=

# Where money lives. Two shapes; src/lib/treasury.ts is the one place that
# says which one a deployment is.
#
# 1. A Bankroll server wallet — what the in-app builder gives an app, and what
#    `bankroll-admin server-wallet:create` provisions for a self-hosted one.
#    The app never holds the wallet's key: BANKROLL_DELEGATED_KEY signs payout
#    REQUESTS, which Bankroll relays to the wallet under its policy. Store the
#    key in Vercel as a SENSITIVE variable (write-only). BANKROLL_OWNER is the
#    creator's own wallet, available for owner-only features.
BANKROLL_PAYEE=
BANKROLL_DELEGATED_KEY=
BANKROLL_DELEGATED_WALLET_ID=
BANKROLL_PRIVY_APP_ID=
BANKROLL_OWNER=
#
# 2. A keypair: a base58 Solana secret key the app signs with itself. It
#    receives payments and signs payouts. Generate one for production that is
#    NOT the development one, and store it as a SENSITIVE variable.
BANKROLL_TREASURY_KEY=

# Matchmaking authenticates this app with its own Ed25519 app key, not the
# treasury or delegated-wallet key. The app's manifest must be verified by
# Bankroll. Local BANKROLL_MOCK=1 supplies a stand-in queue without credentials.
# https://docs.joinbankroll.com/build/matchmaking
BANKROLL_APP_KEY=
# The JWT Bankroll returns after reviewing this origin and its app key.
# The SDK serves it verbatim. Each new tunnel/origin needs its own verification.
BANKROLL_SIGNED_MANIFEST=

# The secret Bankroll signs its webhooks with, handed over with the signed
# manifest (the builder sets it; manifest:sign prints it). The P2P engine's
# payments arrive on /api/bankroll/webhook and the route refuses a delivery
# it cannot verify. Never prefix it with NEXT_PUBLIC_.
# https://docs.joinbankroll.com/build/webhooks
BANKROLL_WEBHOOK_SECRET=

# Where, and from what age, this app takes real money: a JSON policy of
# countries, regions and minimum ages. Bankroll sets it on a builder app.
# Unset means no restriction. Server-side helper:
# src/lib/restrictions.ts; /api/me exposes the decision as `restriction`.
# https://docs.joinbankroll.com/build/restrictions
# Shape: {"version":1,"geo":{"default":"allow","countries":{"US":{"block":["ME"]}}}}
BANKROLL_RESTRICTIONS=

# Entry price and creator fee: server-approved engine offers (engine/p2p/README.md).
# A normal treasury retains the fee; a Bankroll server wallet pays it to
# BANKROLL_OWNER. Ties have no fee.

# Under this flag payoutSigner() returns a mock signer so payout attempts can
# be tested without moving money or holding a key.
# Development only. Lets `npm run check` (and a coding agent) drive the app in
# a plain browser with a stand-in Bankroll host from @joinbankroll/sdk/mock: the
# server accepts its token and its made-up signatures. A production build never
# reads this.
BANKROLL_MOCK=

# Shown when a user connects the app.
BANKROLL_APP_NAME=

# A Solana RPC endpoint. Any provider works; the free tiers are fine to start.
SOLANA_RPC_URL=

# Set automatically when you connect a Vercel Blob store to the project —
# no value to copy by hand.
BLOB_READ_WRITE_TOKEN=
