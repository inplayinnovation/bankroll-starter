# You do not need this file to develop. `npm create @joinbankroll/app` writes
# .env.local at scaffold time — STORE=fs, the app name, and an RPC — and the
# dev signing key lives in ~/.config/bankroll/keypair.json, outside the
# project. This documents what a DEPLOYMENT needs.

# Where state lives. Unset means Vercel Blob, which is what a deployment uses.
# .env.local carries STORE=fs locally so the app runs with no Vercel account;
# it is gitignored, so that never reaches a deployment.
STORE=

# Where money lives. Three shapes; src/lib/treasury.ts is the one place that
# says which one a deployment is.
#
# 1. A Bankroll server wallet — what the in-app builder gives an app, and what
#    `bankroll-admin server-wallet:create` provisions for a self-hosted one.
#    The app never holds the wallet's key: BANKROLL_DELEGATED_KEY signs payout
#    REQUESTS, which Bankroll relays to the wallet under its policy. Store the
#    key in Vercel as a SENSITIVE variable (write-only). BANKROLL_OWNER is the
#    creator's own wallet, which the admin screen is gated on.
BANKROLL_PAYEE=
BANKROLL_DELEGATED_KEY=
BANKROLL_DELEGATED_WALLET_ID=
BANKROLL_PRIVY_APP_ID=
BANKROLL_OWNER=
#
# 2. A keypair: a base58 Solana secret key the app signs with itself. It
#    receives payments and signs payouts. Generate one for production that is
#    NOT the development one, and store it as a SENSITIVE variable.
BANKROLL_TREASURY_KEY=
#
# 3. Charge-only: BANKROLL_PAYEE alone, a wallet ADDRESS that receives payments.
#    The app can take money and cannot pay anyone out — the payout route
#    answers 501.

# Development only. Lets `npm run check` (and a coding agent) drive the app in
# a plain browser with a stand-in Bankroll host from @joinbankroll/sdk/mock: the
# server accepts its token and its made-up signatures. A production build never
# reads this.
BANKROLL_MOCK=

# Shown when a user connects the app.
BANKROLL_APP_NAME=

# A Solana RPC endpoint. Any provider works; the free tiers are fine to start.
SOLANA_RPC_URL=

# Set automatically when you connect a Vercel Blob store to the project —
# no value to copy by hand.
BLOB_READ_WRITE_TOKEN=
